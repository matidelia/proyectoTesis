generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model OAuthToken {
  id           String   @id @default("mercado_libre")
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt
}

model SearchHistory {
  id           String   @id @default(cuid())
  query        String
  timestamp    DateTime @default(now())
  resultsCount Int
}

// Categoría oficial de Mercado Libre (ej: MLA1648 = Computación)
model Category {
  id       String    @id @default(cuid())
  mlId     String    @unique // ID oficial de ML, ej: "MLA1648"
  name     String
  products Product[]
}

model Product {
  id                String          @id @default(cuid())
  mlId              String          @unique
  // Identificador del producto de catalogo de Mercado Libre (item.id de
  // /products/search), estable entre vendedores. mlId, en cambio, es la
  // publicacion puntual del vendedor mas barato en el momento del ultimo
  // scraping y puede cambiar de un scraping a otro sin que sea "otro
  // producto" -- por eso, cuando esta disponible, catalogProductId es la
  // identidad real del producto (ver Cap. 1, subseccion "A que producto
  // se refiere el sistema"). Nullable porque los productos capturados
  // antes de esta migracion no lo tienen retroactivamente.
  catalogProductId String?         @unique
  name              String
  imageUrl          String?
  price             Float?
  currency          String?
  availableQuantity Int?
  condition         String?
  sellerId          BigInt?
  permalink         String?
  lastSeen          DateTime        @default(now())
  categoryId        String?
  category          Category?       @relation(fields: [categoryId], references: [id])
  priceHistory      PriceHistory[]
  trendSnapshots    TrendSnapshot[]
  trendScores       TrendScore[]
  mlPredictions     MLPrediction[]
  watches           Watch[]
  alerts            Alert[]

  @@index([categoryId])
}

// Un cliente "sigue" un producto puntual para recibir alertas de HU02
// cuando ese producto empiece a crecer. Sin esto, la alerta no tendria a
// quien avisarle -- es lo que permite pasar de "hay que ir a mirar el
// dashboard" a "me avisan" (hallazgo de la Entrevista 1 y 2, Seccion 6.7).
model Watch {
  id        String   @id @default(cuid())
  userId    String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

// Alerta generada cuando un producto seguido cruza el umbral de crecimiento
// (mismo umbral de HU02/RF02, Seccion 1.10.2). Se genera en batch
// (scripts/generate_alerts.js), no en cada request; trendScoreId evita
// duplicar la misma alerta si el script se corre mas de una vez sobre el
// mismo calculo de score.
model Alert {
  id            String   @id @default(cuid())
  userId        String
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  trendScoreId  String
  score         Float
  previousScore Float
  scoreDelta    Float
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([userId, trendScoreId])
  @@index([userId])
  @@index([productId])
}

model PriceHistory {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price     Float
  timestamp DateTime @default(now())

  @@index([productId])
}

// Registro temporal de apariciones (base de las métricas de tendencia).
// Cada fila = una aparición del producto en una corrida de minería:
// con qué keyword apareció y en qué posición del catálogo.
// La "frecuencia de aparición" y la "permanencia" se derivan contando
// snapshots por ventana de tiempo.
model TrendSnapshot {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  keyword      String? // keyword de búsqueda con la que apareció
  rankPosition Int? // posición en los resultados del catálogo (1 = primero)
  sellerCount  Int? // cantidad de vendedores activos detectados para este producto de catalogo en esta aparicion (agregacion entre vendedores, ver Seccion 1.10.2)
  capturedAt   DateTime @default(now())

  @@index([productId])
  @@index([capturedAt])
  @@index([productId, capturedAt])
}

// Score de tendencia por producto (RF02): combinación ponderada de las
// métricas temporales. `components` guarda el desglose de la fórmula
// para transparencia académica y trazabilidad.
model TrendScore {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  score      Float // 0 a 100
  period     String // ventana analizada, ej: "7d"
  components Json? // desglose: frecuencia, permanencia, ranking, precio
  computedAt DateTime @default(now())

  @@index([productId])
  @@index([computedAt])
}

// Registro histórico de disponibilidad de endpoints de Mercado Libre
// Permite analizar cuándo se bloquean/desbloquean las APIs a lo largo del tiempo
model EndpointHealthLog {
  id          String   @id @default(cuid())
  endpoint    String   // Ej: "/trends/MLA", "/sites/MLA/search", "/highlights/..."
  label       String   // Nombre descriptivo del endpoint para UI
  httpStatus  Int      // Código HTTP real (200, 403, 401, 429, etc.)
  isAvailable Boolean  // true si 200-299, false en cualquier otro caso
  errorMsg    String?  // Mensaje de error si el endpoint está bloqueado
  latencyMs   Int?     // Tiempo de respuesta en ms (para detectar throttling)
  timestamp   DateTime @default(now())

  @@index([endpoint])
  @@index([timestamp])
  @@index([endpoint, timestamp])
}

// Prediccion del modelo de ML supervisado (Seccion 1.5.4 de la tesis) para
// un producto: probabilidad de que su score siga creciendo en la ventana
// siguiente. Se recalcula corriendo ml/predict.py + scripts/import_ml_predictions.js
// contra el modelo entrenado (ml/model.joblib), no en cada request.
model MLPrediction {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  probability  Float    // 0 a 1: probabilidad de que el score suba >=5 puntos en la ventana siguiente
  modelVersion String   // ej: "random_forest_checkpoint_2026-09-23"
  computedAt   DateTime @default(now())

  @@index([productId])
  @@index([computedAt])
}

// Cuentas de la aplicacion (distintas del OAuthToken, que es la credencial
// de la app contra la API de Mercado Libre). "admin" protege /admin;
// "customer" habilita las funciones del nivel pago del modelo freemium
// (exportacion CSV, evolucion historica completa) en /dashboard.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("customer") // "customer" | "admin"
  createdAt    DateTime @default(now())
}
