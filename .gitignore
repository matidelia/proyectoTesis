# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Backups (contienen datos y tokens - NUNCA commitear)
*.zip
/backups/

# Logs de mineria
mining_log*.txt
watchlist_mining_log.txt

# Archivos de prueba con tokens hardcodeados - NUNCA commitear
test_ml_api.js
analisisAntiGravityApi.txt
test_output.*

# Documentos de tesis (binarios, viven fuera del repo)
*.docx

# Area de trabajo experimental
/scratch/

# Config local de asistentes de codigo (no debe aparecer en el repo publico)
CLAUDE.md
AGENTS.md

# Datos y artefactos del pipeline de ML exportados de produccion o generados
# por los scripts (reproducibles, no versionar; ver ml/train_model.py y ml/predict.py).
# ml/model.joblib SI se versiona: es el modelo ya entrenado que predict.py
# necesita en runtime (CI/CD no reentrena en cada corrida, solo predice).
ml/dataset.json
ml/export_err.log
ml/latest_features.json
ml/predictions.json
